PORT=5000
CLIENT_ORIGIN=http://localhost:3000
MONGODB_URI=
MONGODB_DB=gearharbor
# Optional process-local DNS override if Atlas SRV lookup fails on your network.
MONGODB_DNS_SERVERS=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional Stripe Connect Express account country. If blank, Stripe uses the current platform account country.
STRIPE_CONNECT_COUNTRY=
# GearHarbor percentage of each rental; vendor receives the rest before Stripe fees/refunds/disputes.
VENDOR_PLATFORM_FEE_PERCENT=10
IMGBB_API_KEY=

# Local setup only. Use separate accounts and do not commit credentials.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
